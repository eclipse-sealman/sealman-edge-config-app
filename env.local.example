VITE_VERSION="local-development"
VITE_API_URI="http://localhost:5001/api"

VITE_API_GES_URI=""

# Authentication Provider Selection
# Options: 'keycloak' (default) or 'entra'
# If not set, defaults to 'keycloak'
VITE_AUTHENTICATION_PROVIDER="keycloak"

# Keycloak Configuration (used when VITE_AUTHENTICATION_PROVIDER="keycloak")
VITE_KEYCLOAK_AUTHORITY="http://localhost:8080/realms/local-dev"
VITE_KEYCLOAK_CLIENT_ID="ec-app"

# Entra ID Configuration (used when VITE_AUTHENTICATION_PROVIDER="entra")
VITE_ENTRA_ID_AUTHORITY=
VITE_ENTRA_ID_CLIENT_ID=""
VITE_ENTRA_ID_REDIRECT_URI="http://localhost:3000"

VITE_API_SCOPES=""
VITE_DEPLOYMENT_MANAGER_URI=""
